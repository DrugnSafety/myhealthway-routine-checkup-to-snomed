      "title_row1": "환자 기본정보 및 검진 측정값 요약",
      "header_row": 3,
      "headers": ["항목", "{exam_date_1}", "{exam_date_2}", "단위", "비고"],
      "sections": [
        {
          "header": "■ 환자 식별 정보",
          "items": [
            {"label": "patientName (환자명)",      "field": "patientName",         "unit": "",  "note": "이름"},
            {"label": "birthDate (생년월일)",      "field": "birthDate",           "unit": "",  "note": "JSON 추정"},
            {"label": "patient_id (비식별)",       "field": "patient_id",          "unit": "",  "note": "연구용 ID"}
          ]
        },
        {
          "header": "■ 검진 메타",
          "items": [
            {"label": "examinationDate (검진일)",  "field": "examinationDate",     "unit": "",   "note": ""},
            {"label": "screeningDate (판정일)",    "field": "screeningDate",       "unit": "",   "note": ""},
            {"label": "organizationName (검진기관)","field": "organizationName",   "unit": "",   "note": ""},
            {"label": "판정의사",                  "field": "diagnosingDoctor",    "unit": "",   "note": ""}
          ]
        },
        {
          "header": "■ 계측검사 — 신체 계측",
          "items": [
            {"label": "height (신장)",             "field": "height",              "unit": "cm",     "note": "원시값÷10"},
            {"label": "weight (체중)",             "field": "weight",              "unit": "kg",     "note": "원시값÷10"},
            {"label": "waistCircumference (허리둘레)","field": "waist",            "unit": "cm",     "note": "복부비만 기준 남≥90 여≥85"},
            {"label": "bmi (체질량지수)",          "field": "bmi",                 "unit": "kg/m²",  "note": "정상 18.5–24.9 / 과체중 25–29.9 / 비만 ≥30"},
            {"label": "waist 판정",                "field": "waist_judgment",      "unit": "",       "note": ""},
            {"label": "bmi 판정",                  "field": "bmi_judgment",        "unit": "",       "note": ""}
          ]
        },
        {
          "header": "■ 활력징후",
          "items": [
            {"label": "visionLeft (시력 좌)",      "field": "visionLeft",          "unit": "",       "note": "원시값÷10"},
            {"label": "visionRight (시력 우)",     "field": "visionRight",         "unit": "",       "note": "(교정시력) 표기 보존"},
            {"label": "hearingLeft (청력 좌)",     "field": "hearingLeft",         "unit": "",       "note": "정상/질환의심"},
            {"label": "hearingRight (청력 우)",    "field": "hearingRight",        "unit": "",       "note": "정상/질환의심"},
            {"label": "bloodPressure (혈압)",      "field": "bloodPressure",       "unit": "mmHg",   "note": ""},
            {"label": "systolic (수축기)",         "field": "systolic",            "unit": "mmHg",   "note": ""},
            {"label": "diastolic (이완기)",        "field": "diastolic",           "unit": "mmHg",   "note": ""}
          ]
        },
        {
          "header": "■ 혈액검사",
          "items": [
            {"label": "hemoglobin (혈색소)",       "field": "hemoglobin",          "unit": "g/dL",   "note": "여성 12.0–15.5, 남성 13.0–17.5"},
            {"label": "fastingGlucose (공복혈당)", "field": "fastingGlucose",      "unit": "mg/dL",  "note": "정상<100, IFG 100–125, 당뇨≥126"},
            {"label": "totalCholesterol (총콜레스테롤)","field": "totalCholesterol","unit": "mg/dL", "note": "정상<200"},
            {"label": "hdlCholesterol (HDL)",       "field": "hdlCholesterol",     "unit": "mg/dL",  "note": "여성권장≥50, 남성≥40"},
            {"label": "ldlCholesterol (LDL)",       "field": "ldlCholesterol",     "unit": "mg/dL",  "note": "정상<130"},
            {"label": "triglycerides (중성지방)",   "field": "triglycerides",      "unit": "mg/dL",  "note": "정상<150 / 경계 150–199"},
            {"label": "serumCreatinine (혈청크레아티닌)","field":"serumCreatinine","unit":"mg/dL",   "note": "여성≤1.2"},
            {"label": "egfr (신사구체여과율)",     "field": "egfr",                "unit": "mL/min/1.73m²","note":"정상≥60"},
            {"label": "ast (AST/SGOT)",             "field": "ast",                 "unit": "IU/L",   "note": "정상≤40"},
            {"label": "alt (ALT/SGPT)",             "field": "alt",                 "unit": "IU/L",   "note": "여성정상≤35, 남성≤45"},
            {"label": "gamaGtp (감마GTP)",         "field": "gamaGtp",             "unit": "IU/L",   "note": "여성정상≤35, 남성≤55"}
          ]
        },
        {
          "header": "■ 요검사 / 영상검사",
          "items": [
            {"label": "urinaryProtein (요단백)",   "field": "urinaryProtein",      "unit": "",       "note": "정상/경계/단백뇨의심"},
            {"label": "chestXray (흉부촬영)",      "field": "chestXray",           "unit": "",       "note": "정상/질환의심(비결핵성)/순환기계 질환의심"}
          ]
        }
      ]
    },
